# Copy file này thành secrets.toml (cùng thư mục) rồi điền thông tin thật.
# Trên Streamlit Cloud: dán nội dung này vào mục Settings → Secrets.

# KHÔNG dùng nguyên dòng dưới: đó chỉ là ví dụ về hình dạng chuỗi.
# Lấy chuỗi thật từ Supabase: Connect → Direct → Session pooler, rồi thay [YOUR-PASSWORD]
# bằng mật khẩu database. Mật khẩu nên chỉ gồm chữ và số (ký tự @ : / # làm hỏng chuỗi).
DATABASE_URL = "postgresql://postgres.xxxx:MAT_KHAU_DATABASE@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Mật khẩu để vào trang quản lý
MAT_KHAU = "doi-mat-khau-nay"

# Số Zalo hiện trên trang khách xem
SDT_ZALO = "0905xxxxxx"
